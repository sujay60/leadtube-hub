# Google OAuth2 Credentials (OPTIONAL - for advanced setup)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== SIMPLE SETUP (recommended) =====
# Use Gmail App Password instead of OAuth2
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a new app password
# 3. Paste it below along with your Gmail address
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# App Configuration
PORT=3000
SESSION_SECRET=change_this_to_a_random_string_at_least_32_chars
BASE_URL=http://localhost:3000

# Email Sending Config
EMAIL_DELAY_MS=2000
DAILY_SEND_LIMIT=450
